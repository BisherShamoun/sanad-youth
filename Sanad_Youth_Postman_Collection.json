  },
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Register youth (verify DTO)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "مسار وحقول مبدئية؛ طابقها مع AuthController/RegisterDto.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Bisher\",\n  \"lastName\": \"Test\",\n  \"email\": \"youth1@example.com\",\n  \"username\": \"youth1\",\n  \"password\": \"ChangeMe123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "إذا كان الدخول باسم المستخدم، استبدل email بـ username.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"youth1@example.com\",\n  \"password\": \"ChangeMe123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login response',()=>pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "let j={}; try{j=pm.response.json()}catch(e){}",
                  "const t=j.access_token||j.accessToken||j.token||(j.data&&(j.data.access_token||j.data.accessToken||j.data.token));",
                  "if(t) pm.collectionVariables.set('token',t);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (if implemented)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "قد لا يكون هذا المسار موجوداً في JWT stateless."
          },
          "response": []
        }
      ]
    },
