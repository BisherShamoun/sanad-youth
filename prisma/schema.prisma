// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  SUPERVISOR
  ADMIN
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  }
  enum ApplicationStatus {
    PENDING 
    ACCEPTED
    REJECTED
    CANCELLED 
    }
  enum AnnouncementScope { 
    GENERAL
    PROGRAM 
    }

  model User {
  id           Int           @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String        @unique
  username     String        @unique
  password     String
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  programs     Program[]     @relation("ProgramSupervisor")
  applications Application[]
  announcements Announcement[]
  sessions     Session[]

  @@index([role])
}

model Session {
  id               Int       @id @default(autoincrement())
  userId           Int
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model Program {
  id             Int              @id @default(autoincrement())
  title          String
  description    String           @db.Text
  imagePath      String?
  capacity       Int
  availableSeats Int
  status         ProgramStatus    @default(DRAFT)
  supervisorId   Int
  supervisor     User             @relation("ProgramSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  sessions       ProgramSession[]
  applications   Application[]
  announcements  Announcement[]
  materials      Material[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, title])
  @@index([supervisorId])
}

model ProgramSession {
  id         Int      @id @default(autoincrement())
  programId  Int
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  location   String?
  meetingUrl String?
  createdAt  DateTime @default(now())

  @@index([programId, startsAt])
}

model Application {
  id         Int               @id @default(autoincrement())
  userId     Int
  programId  Int
  status     ApplicationStatus @default(PENDING)
  cvPath     String?
  reviewedBy Int?
  reviewedAt DateTime?
  reviewNote String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  program    Program           @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@index([programId, status])
  @@index([userId, createdAt])
}

model Announcement {
  id        Int               @id @default(autoincrement())
  title     String
  body      String            @db.Text
  scope     AnnouncementScope @default(GENERAL)
  authorId  Int
  programId Int?
  author    User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  program   Program?          @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([scope, createdAt])
  @@index([programId, createdAt])
}

model Material {
  id        Int      @id @default(autoincrement())
  title     String
  filePath  String
  mimeType  String
  size      Int
  programId Int
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([programId])
}
